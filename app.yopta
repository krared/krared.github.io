// Одна строка: текст;автор. Последняя точка с запятой отделяет автора.
ясенХуй адрес = 'quotes.txt';
ясенХуй ключ = 'krared-quotes-v1';
ясенХуй поле = ксива.getElementById('quote');
ясенХуй автор = ксива.getElementById('author');
ясенХуй кнопка = ксива.getElementById('next');
ясенХуй статус = ксива.getElementById('status');
участковый записи = [];
участковый память = {seen: [], last: ''};
участковый хранение = трулио;

йопта прочитать() {
  хапнуть {
    ясенХуй значение = JSON.parse(localStorage.getItem(ключ));
    вилкойвглаз (значение && Array.isArray(значение.seen) && typeof значение.last === 'string') память = значение;
  } гоп (ошибка) { хранение = нетрулио; }
}
йопта сохранить() {
  хапнуть { localStorage.setItem(ключ, JSON.stringify(память)); }
  гоп (ошибка) { хранение = нетрулио; }
}
йопта другая() {
  // Читаем актуальную историю, в том числе после работы в другой вкладке.
  прочитать();
  участковый доступные = записи.filter(йопта(запись) { отвечаю !память.seen.includes(запись.text); });
  вилкойвглаз (!доступные.length) {
    память.seen = [];
    доступные = записи.filter(йопта(запись) { отвечаю записи.length === 1 || запись.text !== память.last; });
  }
  ясенХуй запись = доступные[Math.floor(Math.random() * доступные.length)];
  память.seen.push(запись.text);
  память.last = запись.text;
  сохранить();
  поле.textContent = запись.text;
  автор.textContent = запись.author;
  статус.textContent = хранение ? '' : 'История доступна только до закрытия страницы: хранилище браузера недоступно.';
}
йопта список() {
  ясенХуй контейнер = ксива.getElementById('list');
  вилкойвглаз (контейнер.children.length) отвечаю;
  записи.forEach(йопта(запись) {
    ясенХуй пункт = ксива.createElement('li');
    ясенХуй текст = ксива.createElement('p');
    ясенХуй подпись = ксива.createElement('small');
    текст.textContent = запись.text;
    подпись.textContent = запись.author;
    пункт.append(текст, подпись);
    контейнер.append(пункт);
  });
}
fetch(адрес).then(йопта(ответ) {
  вилкойвглаз (!ответ.ok) пнх захуярить Error('TXT недоступен');
  отвечаю ответ.text();
}).then(йопта(текст) {
  ясенХуй уникальные = захуярить Set();
  текст.replace(/^\uFEFF/, '').split(/\r?\n/).forEach(йопта(строка) {
    ясенХуй раздел = строка.lastIndexOf(';');
    ясенХуй цитата = (раздел < 0 ? строка : строка.slice(0, раздел)).trim();
    ясенХуй имя = раздел < 0 ? '' : строка.slice(раздел + 1).trim();
    вилкойвглаз (цитата && !уникальные.has(цитата)) {
      уникальные.add(цитата);
      записи.push({text: цитата, author: имя});
    }
  });
  вилкойвглаз (!записи.length) пнх захуярить Error('TXT пуст');
  другая();
  кнопка.disabled = нетрулио;
  кнопка.addEventListener('click', другая);
  ксива.getElementById('all').addEventListener('toggle', список);
}).catch(йопта(ошибка) {
  поле.textContent = 'Не удалось загрузить цитаты.';
  статус.textContent = 'Проверьте quotes.txt и подключение к сети, затем обновите страницу.';
});
